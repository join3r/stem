node_modules
dist/
out/
# electron-builder artifacts (see electron-builder.yml directories.output)
release/
*.log
.DS_Store
.vite/

# The Swift helper compiled by scripts/build-mac-helper.mjs (source in native/mac/)
build/native/

# Stem Recall verification probe build output
.recall-build/

# Files-place verification probe build output
.files-build/

# Skill retrieval eval build output (embed-catalog, compiled to CJS)
.skills-build/

# Playwright E2E artifacts
test-results/
playwright-report/

# Local embedding model weights downloaded by scripts/embed-smoke.mjs
.embed-smoke-cache/

# External folders connected for in-place reading (separate repos)
.external/

# The deployment's own, on the machine that runs it (see docs/running-on-a-server.md).
# stem_key holds the passphrase that opens every saved tool credential, .env holds the
# hostname and paths, and state/ is somebody's whole Stem.
.env
stem_key
/state/

# Local Obsidian vault state for docs/ (per-machine editor layout)
docs/.obsidian/

# Harvested from the user's real session logs by scripts/skill-fixtures.mjs, so it
# holds actual conversation content. Regenerate with `npm run fixtures:skills`
# rather than committing it. (skill-retrieval-golden.json IS hand-authored and is
# committed — it is a synthetic library on purpose, so the gate stays stable.)
tests/fixtures/skill-authoring-golden.json

# deploy/auto-update.sh: its default backup folder, its lock, and the commit it
# last had to roll back from.
/backups/
/.auto-update.lock
/.auto-update-failed
