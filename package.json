{
  "name": "stem",
  "version": "0.8.0",
  "description": "An isolated, pi-backed personal assistant with rich MDX output, app-scoped skills, MCP, and Stem Recall memory.",
  "author": {
    "name": "Vladimir Schmotzer",
    "email": "join3r@awantech.sk"
  },
  "main": "dist/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "preflight": "node scripts/preflight.mjs",
    "predev": "npm run preflight && node scripts/brand-electron-dev.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:share": "vite build --config vite.share.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:win": "vitest run tests/unit/exec-executor.test.ts tests/unit/exec-git-bash.test.ts tests/unit/exec-policy.test.ts tests/unit/exec-protected.test.ts tests/unit/exec-service.test.ts tests/unit/embed-files.test.ts tests/unit/embed-import.test.ts tests/unit/embed-catalog.test.ts tests/unit/custom-models.test.ts tests/unit/settings.test.ts",
    "test:server": "node scripts/server-boot.mjs",
    "test:e2e": "playwright test",
    "test:e2e:real": "STEM_E2E_REAL=1 playwright test",
    "test:perf": "STEM_PERF=1 STEM_E2E_REAL=1 playwright test tests/e2e/perf.spec.ts",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "eval:retrieval": "node scripts/recall-eval.mjs",
    "eval:memory": "node scripts/memory-eval.mjs",
    "eval:skills": "node scripts/skill-author-eval.mjs",
    "eval:skill-retrieval": "node scripts/skill-retrieval-eval.mjs",
    "eval:gate-canary": "node scripts/gate-canary.mjs",
    "fixtures:skills": "node scripts/skill-fixtures.mjs",
    "probe:quiet": "node scripts/quiet-mutants.mjs",
    "gen:shortcuts-doc": "node scripts/gen-shortcuts-doc.mjs",
    "eval:mdx": "node scripts/mdx-usage-eval.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@huggingface/transformers": "^4.3.2",
    "acpx": "0.22.0",
    "electron-updater": "^6.8.12",
    "ignore": "^7.0.16",
    "pdfjs-dist": "^6.5.438",
    "pele": "^1.13.0",
    "pi-web-access": "0.48.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "word-extractor": "^1.0.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/word-extractor": "^1.0.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.18",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.77.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "^8.12.3"
    },
    "zod": "^4.6.7"
  }
}
