{
  "name": "stem",
  "version": "0.4.0",
  "description": "An isolated, pi-backed personal assistant with rich MDX output, app-scoped skills, MCP, and Stem Recall memory.",
  "author": {
    "name": "Vladimir Schmotzer",
    "email": "join3r@awantech.sk"
  },
  "main": "dist/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "patch-package && node scripts/ensure-electron.mjs",
    "preflight": "node scripts/preflight.mjs",
    "predev": "npm run preflight && node scripts/brand-electron-dev.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:win": "vitest run tests/unit/exec-executor.test.ts tests/unit/exec-git-bash.test.ts tests/unit/exec-policy.test.ts tests/unit/exec-protected.test.ts tests/unit/exec-service.test.ts tests/unit/embed-files.test.ts tests/unit/embed-import.test.ts tests/unit/embed-catalog.test.ts tests/unit/custom-models.test.ts tests/unit/settings.test.ts",
    "test:server": "node scripts/server-boot.mjs",
    "test:e2e": "playwright test",
    "test:e2e:real": "STEM_E2E_REAL=1 playwright test",
    "test:perf": "STEM_PERF=1 STEM_E2E_REAL=1 playwright test tests/e2e/perf.spec.ts",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "eval:retrieval": "node scripts/recall-eval.mjs",
    "eval:memory": "node scripts/memory-eval.mjs",
    "eval:skills": "node scripts/skill-author-eval.mjs",
    "eval:skill-retrieval": "node scripts/skill-retrieval-eval.mjs",
    "fixtures:skills": "node scripts/skill-fixtures.mjs",
    "probe:quiet": "node scripts/quiet-mutants.mjs",
    "gen:shortcuts-doc": "node scripts/gen-shortcuts-doc.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@huggingface/transformers": "^3.8.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.1.200",
    "pi-web-access": "0.18.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.1.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.61.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.9"
  }
}
