{
  "expo": {
    "name": "Stem",
    "slug": "stem",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "stem",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sk.awantech.stem",
      "appleTeamId": "AX23G9CAL9"
    },
    "android": {
      "package": "sk.awantech.stem",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Stem uses the camera once, to read the pairing code your desktop shows on screen."
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
