{
  "expo": {
    "name": "Stem",
    "slug": "stem",
    "version": "0.5.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "stem",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "sk.awantech.stem",
      "appleTeamId": "AX23G9CAL9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "sk.awantech.stem",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-fg.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Stem uses the camera once, to read the pairing code your desktop shows on screen."
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stem accesses selected photos so you can attach them to chats and mail.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
