{
  "manifest_version": 3,
  "name": "Stem",
  "version": "0.6.0",
  "description": "Lets Stem work in this browser for you.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "tabs",
    "downloads",
    "nativeMessaging",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Stem",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "not_allowed"
}
