# Copy to `.env` beside docker-compose.yml and fill in. Docker Compose reads it
# automatically; nothing here is secret except by association, and the one real
# secret — the passphrase — lives in its own file (STEM_KEY_FILE) rather than in
# an environment variable anything can `docker inspect` back out.

# The public name. It must already point at this server's IP, because Caddy will
# ask Let's Encrypt for a certificate for it on the first boot.
STEM_HOSTNAME=stem.example.com

# Where the state root lives on the host: chats, memory, skills, Files,
# credentials. This is the directory to back up. Relative paths are relative to
# docker-compose.yml.
STEM_STATE_ROOT=./state

# The file holding the passphrase your archive was exported under. Make it with
#   printf '%s' 'the passphrase you exported under' > /root/stem/stem_key
#   chmod 600 /root/stem/stem_key
# A trailing newline is forgiven (`echo` and `printf` both work); anything else
# in the file is taken as part of the passphrase.
STEM_KEY_FILE=./stem_key

# Your timezone, which is the one your scheduled tasks are read in ("every
# weekday at 9" means 9 where you are). A container is UTC unless you say
# otherwise, so set this even if UTC is close enough today.
TZ=Europe/Bratislava

# linux/amd64 unless your server is arm (Hetzner CAX, Ampere, a Pi).
# STEM_PLATFORM=linux/arm64

# uv/uvx is pinned in the Dockerfile so a rebuild is reproducible. To take a
# newer one without editing the file:
#   docker compose build --build-arg UV_IMAGE=ghcr.io/astral-sh/uv:0.13.0

# Node's heap ceiling for the main process. Raise it on a box with room; a 2 GB
# VPS is happier with the default.
# STEM_NODE_OPTIONS=--max-old-space-size=1024

# ---- Ollama for memory search (optional; off unless the profile is on) ----
#
# Uncomment to run Ollama beside Stem, in its own container on the same private
# network. Nothing else about the deployment changes — `docker compose up -d` is
# still the command — and with the line commented out the image is never even
# pulled.
#
# Then, once:
#
#     docker compose exec ollama ollama pull qwen3-embedding:4b
#
# and in Settings → Memory → Embeddings choose your own endpoint with base URL
# `http://ollama:11434` and model `qwen3-embedding:4b`. `localhost` is the one
# thing that does NOT work here: on this server localhost is Stem's own
# container, and Ollama is a neighbour with a name.
#
# Budget ~3 GB of RAM resident for a 4b embedding model on top of Stem's own,
# and ~3 GB of disk for the weights. On a 2 GB VPS use `qwen3-embedding:0.6b`,
# or keep the bundled local embedder, which needs none of this.
# COMPOSE_PROFILES=ollama
#
# Pin the version once you have one that works for you (`docker compose pull
# ollama` is what takes a new one):
# STEM_OLLAMA_TAG=latest
#
# How long a model stays in RAM after the last call. Ollama's default of 5m
# means most turns pay a cold load, because fact ranking happens minutes apart.
# `24h`, or `-1` to never unload, if the box has room to keep it parked.
# STEM_OLLAMA_KEEP_ALIVE=5m

# ---- Push notifications to the iOS app (optional; off unless all four are set) ----
#
# Without these, Stem sends no notifications and does no work towards them — the
# server is exactly what it was. With them, an approval card, a long turn ending
# or a task alert also taps the phone on the shoulder; the notification carries
# ids and a short label and never a message (src/server/push/).
#
# The key is the .p8 Apple hands you once, for a key with the APNs service
# enabled. It has to be INSIDE the container, so mount it in docker-compose.yml
# beside the state root:
#
#     - ${STEM_APNS_KEY_FILE}:/var/lib/stem/apns.p8:ro
#
# and point STEM_APNS_KEY_PATH at the path it has in there.
#
# STEM_APNS_KEY_FILE=./AuthKey_ABCD123456.p8
# STEM_APNS_KEY_PATH=/var/lib/stem/apns.p8
# STEM_APNS_KEY_ID=ABCD123456
# STEM_APNS_TEAM_ID=YOURTEAMID
# STEM_APNS_BUNDLE_ID=sk.awantech.stem
# Sandbox unless this says production. A TestFlight or Xcode build is sandbox;
# getting this wrong means every push is refused, never misdelivered.
# STEM_APNS_ENV=production
